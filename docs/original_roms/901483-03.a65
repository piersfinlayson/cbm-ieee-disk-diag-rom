        sta     $04,x
        jmp     LFFBA

; Head Positioning ($FF7A-$FFBA)
; Controls stepper motor phase transitions via 6522 VIA at $40
; Implements stepper motor control with 3 (8050) or 5 (8250) phases per track

; Inward Movement (toward higher track numbers)
LFF7A:  asl     a           ; Test direction bit from command
        bcs     LFF94       ; Branch if moving outward (toward track 0)
        dec     $23,x       ; Decrement step timing counter
        bne     LFF88       ; If not zero yet, skip phase change
        lda     $04A3       ; Load step rate timing value
        sta     $23,x       ; Reset timing counter
        dec     $06,x       ; Decrement track position counter
LFF88:  lda     $40         ; Load current motor phase bits
        and     LFFD7,x     ; Mask with phase pattern ($0C or $03)
        sec                 ; Set carry for subtraction
        sbc     LFFD3,x     ; Rotate phase pattern (subtract $04 or $01)
        jmp     LFFA8       ; Jump to output routine

; Outward Movement (toward track 0)
LFF94:  dec     $23,x       ; Decrement step timing counter
        bne     LFF9F       ; If not zero yet, skip phase change
        lda     $04A3       ; Load step rate timing value
        sta     $23,x       ; Reset timing counter
        inc     $06,x       ; Increment track position counter
LFF9F:  lda     $40         ; Load current motor phase bits
        and     LFFD7,x     ; Mask with phase pattern ($0C or $03)
        clc                 ; Clear carry for addition
        adc     LFFD3,x     ; Rotate phase pattern (add $04 or $01)

; Phase Pattern Output (common to both directions)
LFFA8:  and     LFFD7,x     ; Ensure only motor phase bits are affected
        sta     $08         ; Store new phase pattern temporarily
        lda     $40         ; Reload full port value
        and     LFFD1,x     ; Clear phase bits from current port value
        ora     $08         ; Combine with new phase pattern
        sta     $40         ; Update VIA output port with new phase pattern
        lda     $82         ; Load record pointer
        and     #$FE        ; Clear bit 0 (prepare for next operation)

